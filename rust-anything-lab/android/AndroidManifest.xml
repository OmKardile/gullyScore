<?xml version="1.0" encoding="utf-8"?>
<!-- GullyScore (Rust) — NativeActivity APK. Pure Rust: no Java/Kotlin code
     (hasCode=false), loads libgullyscore_app.so built from rust/app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.omkardile.gullyscore.rust"
    android:versionCode="1"
    android:versionName="0.2.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <application
        android:label="GullyScore Rust"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="false"
        android:allowBackup="true">

        <activity
            android:name="android.app.NativeActivity"
            android:label="GullyScore Rust"
            android:exported="true"
            android:screenOrientation="userPortrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode|smallestScreenSize">
            <!-- Tell NativeActivity which .so to load -->
            <meta-data android:name="android.app.lib_name" android:value="gullyscore_app" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
