# Copy to keystore.properties (same directory) and fill in your release
# keystore credentials. keystore.properties and gullyscore-release.keystore
# are gitignored — keep backups of both. Without them, assembleRelease falls
# back to debug signing (installable, but not upgradable over release-signed
# installs).
storePassword=CHANGE_ME
keyAlias=gullyscore
keyPassword=CHANGE_ME
